APP_NAME=OpenResearch Graph
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=openresearch
POSTGRES_USER=openresearch_user
POSTGRES_PASSWORD=change_this_in_production
DATABASE_URL=postgresql+asyncpg://openresearch_user:change_this_in_production@postgres:5432/openresearch
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

OPENALEX_MODE=seed
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384

LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

BILLING_MODE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=noreply@example.com

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

MAX_UPLOAD_SIZE_MB=25
MAX_FREE_DOCUMENTS=3
MAX_PREMIUM_DOCUMENTS=50
MAX_FREE_CHAT_MESSAGES_PER_DAY=20
FREE_SEARCHES_PER_HOUR=20
PREMIUM_SEARCHES_PER_HOUR=200

LOGIN_ATTEMPTS_PER_15_MINUTES=10
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

SEARCH_CANDIDATE_POOL=300
SEARCH_KEYWORD_WEIGHT=0.30
SEARCH_SEMANTIC_WEIGHT=0.35
SEARCH_CITATION_WEIGHT=0.15
SEARCH_RECENCY_WEIGHT=0.10
SEARCH_OPEN_ACCESS_WEIGHT=0.05
SEARCH_RERANK_WEIGHT=0.05

RAG_CANDIDATE_POOL=30
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=12000
RAG_MMR_LAMBDA=0.75

RECOMMENDATION_CANDIDATE_POOL=500
RECOMMENDATION_CONTENT_WEIGHT=0.35
RECOMMENDATION_COLLABORATIVE_WEIGHT=0.20
RECOMMENDATION_GRAPH_WEIGHT=0.15
RECOMMENDATION_POPULARITY_WEIGHT=0.12
RECOMMENDATION_RECENCY_WEIGHT=0.10
RECOMMENDATION_OPEN_ACCESS_WEIGHT=0.03
RECOMMENDATION_FEEDBACK_WEIGHT=0.05
RECOMMENDATION_DIVERSITY_LAMBDA=0.80
